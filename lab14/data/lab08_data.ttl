# ---------------- Правила верифікації ----------------
:Pravylo_R1 a :PravyloVeryfikatsii ; rdfs:label "R1" ;
    :umovaPravyla "вік акаунта < 30 днів AND акаунт не верифікований" ;
    :diiaPravyla "індекс довіри = знижений" .

:Pravylo_R2 a :PravyloVeryfikatsii ; rdfs:label "R2" ;
    :umovaPravyla "автор має спростоване твердження (фейк / маніпуляція) у публікації з ≥ 1000 поширень" ;
    :diiaPravyla "знизити індекс довіри автора на один рівень шкали" .

