MATCH (a:KBEntity {iri: "http://www.lnu.edu.ua/kb/entity/METHOD_дезінформування_від_зворотного"}), (b:KBEntity {iri: "http://www.lnu.edu.ua/kb/entity/дезінформація"}) CREATE (a)-[:SUBTYPE_OF {source: "W01", offset_start: 983, offset_end: 1152, evidence: "Дезінформування від зворотного — відбувається шляхом надання правдивих відомостей у спотвореному вигляді чи в такий спосіб, що об'єкт спрямувань сприймає їх як брехливі.", method: "B:LLM+schema", model: "qwen2.5:7b (qwen2 7.6B Q4_K_M)", prompt_version: "llm_v1", confidence: 0.5, status: "candidate", extracted_at: "2026-11-04T19:42:32"}]->(b);
