MATCH (a:KBEntity {iri: "http://www.lnu.edu.ua/kb/entity/CASE_ID_операція_Фортитьюд"}), (b:KBEntity {iri: "http://www.lnu.edu.ua/kb/entity/дезінформація"}) CREATE (a)-[:SPREADS {source: "W01", offset_start: 1590, offset_end: 1873, evidence: "Серед відомих прикладів таких операцій з дезінформації — введення противника в оману - можна назвати операцію «Фортитьюд» (травень-червень 1944 року), яка відвернула увагу німецького командування та переконала його, що висадка союзників якщо і буде, то в Скандинавії та в Па-де-Кале.", method: "B:LLM+schema", model: "qwen2.5:7b (qwen2 7.6B Q4_K_M)", prompt_version: "llm_v1", confidence: 0.5, status: "candidate", extracted_at: "2026-11-04T19:42:32"}]->(b);
